// GpuSkin-patch variant of split_texture.fx
// Used for glass/bullet effects - materials request TShader technique
// This variant implements full GPU skinning to satisfy engine validator

#include "common/common_defines.nfx"

#ifdef GPU_SKIN_ENABLE
    float4x4 g_mBone[60];
#endif

struct VS_INPUT {
    float4 Position : POSITION;
    float2 TexCoord0 : TEXCOORD0;
    float3 Normal : NORMAL;
#ifdef GPU_SKIN_ENABLE
    float4 BlendIndices : BLENDINDICES;
    float4 BlendWeights : BLENDWEIGHT;
#endif
};

struct VS_OUTPUT {
    float4 Position : SV_POSITION;
    float2 TexCoord0 : TEXCOORD0;
    float3 Normal : TEXCOORD1;
};

VS_OUTPUT vs_main(VS_INPUT input) {
    VS_OUTPUT output;

#ifdef GPU_SKIN_ENABLE
    // Full GPU skinning with bone matrices - required by engine validator
    float4 pos = float4(0, 0, 0, 1);
    float3 norm = float3(0, 0, 0);

    // Bone 0
    if (input.BlendWeights.x > 0.0) {
        int idx0 = int(input.BlendIndices.x);
        pos += mul(input.Position, g_mBone[idx0]) * input.BlendWeights.x;
        norm += mul(input.Normal, (float3x3)g_mBone[idx0]) * input.BlendWeights.x;
    }
    // Bone 1
    if (input.BlendWeights.y > 0.0) {
        int idx1 = int(input.BlendIndices.y);
        pos += mul(input.Position, g_mBone[idx1]) * input.BlendWeights.y;
        norm += mul(input.Normal, (float3x3)g_mBone[idx1]) * input.BlendWeights.y;
    }
    // Bone 2
    if (input.BlendWeights.z > 0.0) {
        int idx2 = int(input.BlendIndices.z);
        pos += mul(input.Position, g_mBone[idx2]) * input.BlendWeights.z;
        norm += mul(input.Normal, (float3x3)g_mBone[idx2]) * input.BlendWeights.z;
    }
    // Bone 3
    if (input.BlendWeights.w > 0.0) {
        int idx3 = int(input.BlendIndices.w);
        pos += mul(input.Position, g_mBone[idx3]) * input.BlendWeights.w;
        norm += mul(input.Normal, (float3x3)g_mBone[idx3]) * input.BlendWeights.w;
    }

    output.Position = mul(pos, g_mWorldViewProj);
    output.Normal = normalize(mul(norm, (float3x3)g_mWorld));
#else
    output.Position = mul(input.Position, g_mWorldViewProj);
    output.Normal = normalize(mul(input.Normal, (float3x3)g_mWorld));
#endif

    output.TexCoord0 = input.TexCoord0;
    return output;
}

float4 ps_main(VS_OUTPUT input) : SV_TARGET {
    // Simple texture lookup for split/glass effects
    float4 color = tex2D(g_tDiffuse, input.TexCoord0);
    return color;
}

technique tech0 {
    pass p0 {
        VertexShader = compile vs_3_0 vs_main();
        PixelShader = compile ps_3_0 ps_main();
    }
}

// Alias for engine compatibility - materials request TShader technique
technique TShader < string MTLTechnique = "TShader"; > {
    pass p0 {
        VertexShader = compile vs_3_0 vs_main();
        PixelShader = compile ps_3_0 ps_main();
    }
}
